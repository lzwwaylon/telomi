# Telomi binds its API to loopback. Setting TELOMI_HOST=0.0.0.0 exposes the
# unauthenticated single-user API and is unsafe without an external access layer.
# TELOMI_HOST=127.0.0.1
# PORT=8787

# Optional local audio runtime tuning. STT/TTS model, connection and credential selection
# live in the settings page (Models and Services), not in the environment.
# TELOMI_AUDIO_STT_BASE_URL=http://GPU_HOST:9596/v1
# Rate real-time speech PCM is framed at, for whichever connection speaks it.
# TELOMI_AUDIO_TTS_SAMPLE_RATE=24000

# LIVEKIT_URL=ws://LIVEKIT_HOST:7880
# LIVEKIT_PUBLIC_URL=ws://LIVEKIT_HOST:7880
# LIVEKIT_API_KEY=replace-me
# LIVEKIT_API_SECRET=replace-me
# TELOMI_LIVEKIT_BRIDGE_SECRET=replace-me
# TELOMI_URL=http://TELOMI_HOST:8787

# Browser Provider is always available for authenticated or dynamic research sources.
# Two installations on one machine must not share this CDP port: the second would attach
# to the first one's managed Chrome and its logins. The Worktree tooling allocates distinct ports.
TELOMI_BROWSER_HOST_CDP_URL=http://127.0.0.1:9222
TELOMI_BROWSER_MAX_CONCURRENT_WORKSPACES=2
# Headless by default; opt in to a visible Chrome window for debugging.
TELOMI_BROWSER_HEADED=false

# Local Hindsight memory. Install with `npm run memory:install`; Telomi starts
# the native Python process on demand and binds it to loopback only.
HINDSIGHT_URL=http://127.0.0.1:18888/v1/default
# Keep this project identity stable when moving the project between hosts.
HINDSIGHT_BANK_ID=telomi-user
# Memory storage. Unset, each installation uses its own local pg0 instance named after its
# data directory. Set this only to point at a specific PostgreSQL or pg0 instance; two
# installations on one machine must not share one, or an embedding change in one rewrites the other.
# HINDSIGHT_API_DATABASE_URL=pg0://telomi
# Memory LLM, reranker and embedding model selection lives in the settings page, not here.

# YouTube public operations are Cookie-free. Account operations automatically
# reuse the project-managed Chrome Profile. These remain explicit overrides.
# PI_YOUTUBE_YTDLP_COOKIE_FILE=/absolute/path/to/youtube-cookies.txt
# PI_YOUTUBE_YTDLP_COOKIES_FROM_BROWSER=chrome:Profile 1

# Hugging Face and X credentials are discovered from existing local login
# state. These optional overrides take precedence over automatic discovery.
# SOURCE_SERVICE_HUGGINGFACE_TOKEN=hf_example
# SOURCE_SERVICE_TWITTER_COOKIE_FILE=/absolute/path/to/x-cookies.txt

# Download/parse cache freshness is independent from disk retention.
# Defaults: 24h mutable freshness, 30d without use, 50 GiB unique object budget, hourly GC.
# Workspace Snapshots stay protected even when their bytes exceed the capacity target.
# SOURCE_SERVICE_MATERIAL_CACHE_TTL_SECONDS=86400
# SOURCE_SERVICE_MATERIAL_CACHE_RETENTION_SECONDS=2592000
# SOURCE_SERVICE_MATERIAL_CACHE_MAX_BYTES=53687091200
# SOURCE_SERVICE_MATERIAL_CACHE_GC_INTERVAL_SECONDS=3600
