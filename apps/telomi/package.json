{
  "name": "telomi",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "boot": "./start.sh",
    "dev": "python3 scripts/worktree.py launch -- concurrently -k --names \"server,web\" --prefix-colors \"cyan,green\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "python3 scripts/worktree.py launch -- node --watch --import tsx server/index.ts",
    "dev:web": "python3 scripts/worktree.py launch -- vite",
    "dev:full-duplex": "python3 scripts/worktree.py launch -- concurrently -k --names \"server,web,livekit,voice\" --prefix-colors \"cyan,green,magenta,yellow\" \"npm run dev:server\" \"npm run dev:web\" \"npm run dev:livekit\" \"npm run dev:voice-agent\"",
    "dev:livekit": "python3 scripts/worktree.py launch -- livekit-server --dev --bind 0.0.0.0 --node_selector.cpu_load_limit 100 --node_selector.sysload_limit 100",
    "dev:voice-agent": "python3 scripts/worktree.py launch -- node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx server/voice/livekit-agent-worker.ts dev",
    "build": "vite build",
    "start": "python3 scripts/worktree.py launch -- node --import tsx server/index.ts",
    "memory:install": "uv sync --project services/hindsight --frozen --python 3.11",
    "agent-python:install": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx scripts/install-prime-kernel.ts",
    "test:memory-runtime": "npm test -- \"tests/goals/test-hindsight-*.ts\"",
    "research:install": "uv sync --project services/research-source-service --frozen --extra dev --python 3.11",
    "audio:install": "uv sync --project ../telomi-audio-local --frozen --python 3.12",
    "test:audio-python": "../telomi-audio-local/.venv/bin/python -m unittest discover -s ../telomi-audio-local -p 'test_*.py'",
    "research:dev": "python3 scripts/worktree.py launch -- services/research-source-service/.venv/bin/python -m research_source_service",
    "research:gc": "services/research-source-service/.venv/bin/python services/research-source-service/scripts/gc_material_cache.py",
    "test:research-api": "services/research-source-service/.venv/bin/python -m pytest -q services/research-source-service/tests",
    "test:sandbox-crossvolume": "tsx tests/agent-runtime/test-sandbox-crossvolume.ts",
    "typecheck": "tsc --noEmit && npm run typecheck:tests",
    "install-hook": "git config --worktree core.hooksPath \"$PWD/hooks\"",
    "test:pre-commit-plan": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --types node scripts/pre-commit-plan.ts scripts/test-pre-commit-plan.ts && tsx scripts/test-pre-commit-plan.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test:ci": "npm test && npm run test:operations-openapi",
    "test:activity-resume-e2e": "node tests/events/test-activity-resume-e2e.mjs",
    "test:wiki-activity-e2e": "node tests/wiki/test-wiki-activity-e2e.mjs",
    "test:research": "npm test -- \"tests/{research,agent-runtime,goals,wiki}/test-*.{ts,tsx}\" && npm run test:writing-skill",
    "test:writing-skill": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=agents/research/report-writer/skills/writing-skill/src services/research-source-service/.venv/bin/python -m pytest -q -p no:cacheprovider agents/research/report-writer/skills/writing-skill/tests",
    "test:prime-agent-auto-refine": "tsx tests/agent-runtime/test-prime-agent-auto-refine.ts",
    "test:wiki-update-resume-api-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/wiki/test-wiki-update-resume-api-live.ts",
    "test:wiki-published-tools-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/wiki/test-wiki-published-tools-live.ts",
    "generate:operations-openapi": "tsx scripts/generate-operations-openapi.ts",
    "test:operations-openapi": "tsx scripts/generate-operations-openapi.ts --check",
    "test:evolution": "npm test -- \"tests/evolution/test-*.ts\"",
    "test:provider-contract": "npm test -- \"tests/{providers,research,config,agent-runtime}/test-*.{ts,tsx}\" && npm run test:provider-python-sdk && npm run test:research-api",
    "dump:system-prompt": "node --import tsx scripts/dump-system-prompt.ts",
    "test:provider-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx scripts/run-provider-live-coverage.ts",
    "test:browser-ownership-e2e": "node --import tsx tests/providers/test-browser-ownership-e2e.ts",
    "test:browser-profile-e2e": "node --import tsx tests/providers/test-browser-profile-persistence-e2e.ts",
    "test:ingestion-audio-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/ingestion/test-audio-live.ts",
    "test:youtube-provider-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/research/test-youtube-provider-live.ts",
    "test:youtube-account-functions-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/research/test-youtube-account-functions-live.ts",
    "test:youtube-public-functions-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/research/test-youtube-public-functions-live.ts",
    "test:provider-python-sdk": "services/research-source-service/.venv/bin/python -m unittest discover -s server/research/python-tools/tests -p 'test_*.py'",
    "test:research-sources-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/research/test-research-sources-live.ts",
    "test:huggingface-source-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/research/test-huggingface-source-live.ts",
    "test:twitter-source-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/research/test-twitter-source-live.ts",
    "test:twitter-followers-lists-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/research/test-twitter-followers-lists-live.ts",
    "test:research-model-gateway": "tsx tests/research/test-research-model-gateway.ts",
    "test:codex-usage-protocol-live": "node --import tsx tests/accounts/test-codex-usage-protocol-live.ts",
    "test:codex-auth-isolation-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/accounts/test-codex-auth-isolation-live.ts",
    "test:document-parsing-runtime": "services/research-source-service/.venv/bin/python -m pytest -q services/research-source-service/tests/test_documents.py",
    "evidence": "tsx scripts/evidence-cli.ts",
    "test:media-generate-status-e2e": "node tests/media/test-media-generate-status-e2e.mjs",
    "test:voice-stt": "npm test -- \"tests/voice/test-*.{ts,tsx}\"",
    "test:voice-interaction": "npm test -- \"tests/voice/test-*livekit*.{ts,tsx}\" tests/voice/test-goal-agent-voice-adapter.ts",
    "browser:voice-e2e:open": "agent-browser --config scripts/agent-browser.voice-e2e.json open",
    "browser:voice-e2e:close": "agent-browser --config scripts/agent-browser.voice-e2e.json close",
    "test:voice-stt-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/voice/test-voice-stt-live.ts",
    "test:voice-realtime-stt-live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx tests/voice/test-livekit-snapshot-stt-live.ts",
    "eval:voice-stt": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx scripts/evaluate-voice-stt.ts",
    "eval:voice-stt:cold": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx scripts/evaluate-voice-stt.ts --run-class cold --isolated-cold-sidecar",
    "eval:voice-stt:first-partial": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx scripts/evaluate-voice-stt.ts --run-class warm --measure-first-partial",
    "eval:voice-stt:promote-hardware": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx scripts/prepare-voice-hardware-eval.ts",
    "eval:voice-stt:remove-hardware": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx scripts/prepare-voice-hardware-eval.ts",
    "eval:voice-stt:rematerialize-hardware": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.worktree --import tsx scripts/prepare-voice-hardware-eval.ts",
    "generate:voice-vad-fixtures": "node --import tsx scripts/generate-voice-vad-fixtures.ts",
    "generate:voice-public-acoustic-fixtures": "node --import tsx scripts/generate-public-acoustic-fixtures.ts",
    "test:citation-image-dialog-e2e": "node tests/web/test-citation-image-dialog-e2e.mjs",
    "test:agent-registry": "npm test -- \"tests/agent-runtime/test-*-registry.ts\"",
    "browser:start": "tsx scripts/chrome-debug.ts start",
    "browser:start:sync": "tsx scripts/chrome-debug.ts start --sync",
    "browser:start:headed": "tsx scripts/chrome-debug.ts start --headed",
    "browser:start:sync:headed": "tsx scripts/chrome-debug.ts start --sync --headed",
    "browser:status": "tsx scripts/chrome-debug.ts status",
    "browser:stop": "tsx scripts/chrome-debug.ts stop",
    "browser:sync": "tsx scripts/chrome-debug.ts sync-default",
    "browser:profiles": "tsx scripts/chrome-debug.ts profiles",
    "test": "node --import tsx scripts/run-tests.ts",
    "browser:monitor:harness": "node --import tsx tests/providers/browser-monitor-harness.ts",
    "test:web": "npm test -- \"tests/web/test-*.{ts,tsx}\""
  },
